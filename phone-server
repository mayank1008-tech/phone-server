#!/bin/bash
# ==============================================================================
# Stealth Tor v3 Phone Server - Master CLI & Interactive Dashboard
# ==============================================================================
# Unified CLI management tool for headless, zero-discovery Android servers
# over stealth Tor v3 (x25519) and OpenSSH (Ed25519).
# ==============================================================================

# set -e intentionally omitted to prevent abrupt menu termination on handled errors

VERSION="1.2.0"

# ANSI Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

# Determine root repository directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Detect runtime environment
IS_TERMUX=0
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
if [ -d "/data/data/com.termux" ]; then
    IS_TERMUX=1
fi

# Locate setup scripts dynamically across common paths
find_script() {
    local name="$1"
    if [ -f "$SCRIPT_DIR/$name" ]; then
        echo "$SCRIPT_DIR/$name"
    elif [ -f "$PWD/$name" ]; then
        echo "$PWD/$name"
    elif [ -f "$HOME/stealth-tor-phone-server/$name" ]; then
        echo "$HOME/stealth-tor-phone-server/$name"
    elif [ -f "$HOME/Downloads/$name" ]; then
        echo "$HOME/Downloads/$name"
    elif [ -f "/sdcard/Download/$name" ]; then
        echo "/sdcard/Download/$name"
    elif [ -f "$HOME/$name" ]; then
        echo "$HOME/$name"
    else
        echo ""
    fi
}

# Auto-start local Tor proxy if inactive
ensure_local_tor_active() {
    if (echo > /dev/tcp/127.0.0.1/9050) >/dev/null 2>&1; then
        return 0
    fi
    echo -e "${YELLOW}[*] Local Tor proxy (127.0.0.1:9050) is inactive. Starting Tor...${NC}"
    if [ "$IS_TERMUX" -eq 1 ]; then
        nohup tor > "$PREFIX/var/lib/tor/client_tor.log" 2>&1 &
        for i in $(seq 1 15); do
            if (echo > /dev/tcp/127.0.0.1/9050) >/dev/null 2>&1; then
                echo -e "${GREEN}[+] Local Tor proxy is active.${NC}"
                return 0
            fi
            sleep 1
        done
    else
        if command -v systemctl >/dev/null 2>&1; then
            sudo systemctl start tor tor@default 2>/dev/null || true
        elif command -v service >/dev/null 2>&1; then
            sudo service tor start 2>/dev/null || true
        fi
        for i in $(seq 1 10); do
            if (echo > /dev/tcp/127.0.0.1/9050) >/dev/null 2>&1; then
                echo -e "${GREEN}[+] Local Tor proxy is active.${NC}"
                return 0
            fi
            sleep 1
        done
    fi
    echo -e "${RED}[!] Warning: Could not verify local Tor proxy on 127.0.0.1:9050.${NC}"
}

show_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "=================================================================="
    echo "        STEALTH TOR v3 PHONE SERVER CLI (v${VERSION})            "
    echo "=================================================================="
    echo -e "${NC}"
}

show_help() {
    show_banner
    echo -e "${BOLD}USAGE:${NC}"
    echo "  phone-server [COMMAND] [OPTIONS]"
    echo "  phone-server                         (Launches contextual interactive dashboard)"
    echo ""
    echo -e "${BOLD}CLIENT COMMANDS (Workstation / Secondary Phone):${NC}"
    echo "  connect [ssh-args]                   Open SSH shell into phone server (alias: ssh)"
    echo "  status [--adb]                       Query remote phone server status over Tor"
    echo "  stop [--adb]                         Shutdown remote server daemons over Tor"
    echo "  restart [--adb]                      Restart remote server daemons over Tor"
    echo "  setup client-linux [onion] [user]    Install Linux client dependencies & keys"
    echo "  setup client-termux [onion] [user]   Install mobile Termux client dependencies & keys"
    echo ""
    echo -e "${BOLD}SERVER COMMANDS (Run on Server Phone):${NC}"
    echo "  start                                Start OpenSSH & Tor daemons on phone"
    echo "  stop                                 Force terminate listeners & worker sessions"
    echo "  restart                              Cleanly restart server daemons on phone"
    echo "  status                               Check local PIDs, socket states, and battery"
    echo "  authorize [name] [tor_pub] [ssh_pub] Register a new client device on server"
    echo "  setup server                         Run full server installer on Android Termux"
    echo ""
    echo -e "${BOLD}DASHBOARDS & UTILITIES:${NC}"
    echo "  client                               Open Client Dashboard interactive menu"
    echo "  server                               Open Server Dashboard interactive menu"
    echo "  install                              Install phone-server globally into system PATH"
    echo "  -v, --version, version               Display CLI version"
    echo "  -h, --help, help                     Display this help message"
    echo ""
    echo -e "${BOLD}EXAMPLES:${NC}"
    echo "  phone-server                         # Open interactive dashboard"
    echo "  phone-server connect                 # Log into phone server"
    echo "  phone-server status                  # Check phone server health"
    echo "  phone-server authorize laptop        # Authorize client keys on server"
    echo "  phone-server client                  # Launch Client menu explicitly"
    echo "  phone-server server                  # Launch Server menu explicitly"
    echo "=================================================================="
}

install_global() {
    echo -e "${BLUE}[*] Installing phone-server CLI globally...${NC}"
    local SOURCE_FILE="${BASH_SOURCE[0]}"
    if [ -L "$SOURCE_FILE" ]; then
        SOURCE_FILE="$(readlink -f "$SOURCE_FILE" 2>/dev/null || echo "$SOURCE_FILE")"
    fi
    if [ ! -f "$SOURCE_FILE" ]; then
        SOURCE_FILE=$(find_script "phone-server")
    fi

    if [ "$IS_TERMUX" -eq 1 ]; then
        TARGET="$PREFIX/bin/phone-server"
        if [ "$SOURCE_FILE" != "$TARGET" ] && [ -f "$SOURCE_FILE" ]; then
            cp "$SOURCE_FILE" "$TARGET"
        fi
        chmod 755 "$TARGET"
        ln -sf "$TARGET" "$PREFIX/bin/stealth-server"
        echo -e "${GREEN}[+] Installed to $TARGET (and alias stealth-server).${NC}"
    else
        mkdir -p "$HOME/.local/bin"
        TARGET="$HOME/.local/bin/phone-server"
        if [ "$SOURCE_FILE" != "$TARGET" ] && [ -f "$SOURCE_FILE" ]; then
            cp "$SOURCE_FILE" "$TARGET"
        fi
        chmod +x "$TARGET"
        ln -sf "$TARGET" "$HOME/.local/bin/stealth-server"
        
        # Ensure ~/.local/bin in PATH
        for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
            if [ -f "$rc" ]; then
                if ! grep -q 'export PATH="$HOME/.local/bin:$PATH"' "$rc" 2>/dev/null; then
                    echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$rc"
                fi
            fi
        done
        echo -e "${GREEN}[+] Installed to $TARGET (and alias stealth-server).${NC}"
        echo -e "${YELLOW}[*] PATH updated in shell configuration.${NC}"
    fi
}

# --- Client Implementation ---

cmd_client_connect() {
    # Check if running directly on the server phone
    if [ "$IS_TERMUX" -eq 1 ] && [ -f "$PREFIX/var/lib/tor/hidden_ssh/hostname" ]; then
        echo -e "${YELLOW}[*] You are currently on the Phone Server itself.${NC}"
        echo "    Opening local Termux shell..."
        exec "${SHELL:-/data/data/com.termux/files/usr/bin/bash}"
        return
    fi

    ensure_local_tor_active

    if command -v phone-ssh >/dev/null 2>&1; then
        phone-ssh "$@"
    elif [ -x "$PREFIX/bin/phone-ssh" ]; then
        "$PREFIX/bin/phone-ssh" "$@"
    elif [ -x "$HOME/.local/bin/phone-ssh" ]; then
        "$HOME/.local/bin/phone-ssh" "$@"
    else
        ssh phone-server "$@"
    fi
}

cmd_client_status() {
    # If on server phone, run local server status directly
    if [ "$IS_TERMUX" -eq 1 ] && [ -f "$PREFIX/var/lib/tor/hidden_ssh/hostname" ]; then
        cmd_server_status "$@"
        return
    fi

    if [ "$1" == "--adb" ]; then
        if command -v adb >/dev/null 2>&1; then
            echo "[*] Querying Phone Server status directly via ADB..."
            adb shell '/data/data/com.termux/files/usr/bin/status-server'
            return $?
        else
            echo -e "${RED}[!] ADB is not installed or not in PATH.${NC}"
            return 1
        fi
    fi

    ensure_local_tor_active

    echo "[*] Connecting to Phone Server over Tor..."
    if ! ssh -o ConnectTimeout=30 phone-server status-server "$@"; then
        echo ""
        echo -e "${YELLOW}[!] Could not reach Phone Server over Tor.${NC}"
        echo "    Troubleshooting tips:"
        echo "    1. If the server was recently started/restarted, Tor takes ~30-45 seconds"
        echo "       to publish hidden service descriptors. Please wait a moment and retry."
        echo "    2. Ensure phone server is powered on and plugged into a charger."
        echo "    3. Ensure phone server has an active Wi-Fi or mobile data connection."
        echo "    4. Ensure Termux wakelock is acquired on the server."
    fi
}

cmd_client_stop() {
    if [ "$IS_TERMUX" -eq 1 ] && [ -f "$PREFIX/var/lib/tor/hidden_ssh/hostname" ]; then
        cmd_server_stop "$@"
        return
    fi

    ensure_local_tor_active

    echo "[*] Sending stop signal to Phone Server over Tor..."
    ssh -o ConnectTimeout=30 phone-server stop-server 2>/dev/null || true
    echo "[+] Phone server daemons terminated successfully."
}

cmd_client_restart() {
    if [ "$IS_TERMUX" -eq 1 ] && [ -f "$PREFIX/var/lib/tor/hidden_ssh/hostname" ]; then
        cmd_server_restart "$@"
        return
    fi

    ensure_local_tor_active

    echo "[*] Restarting Phone Server over Tor..."
    ssh -o ConnectTimeout=30 phone-server restart-server "$@"
}

# --- Server Implementation ---

cmd_server_start() {
    if [ "$IS_TERMUX" -ne 1 ]; then
        echo -e "${RED}[!] 'start' must be run directly on the Phone Server (Termux).${NC}"
        return 1
    fi
    if [ -x "$PREFIX/bin/start-server" ]; then
        "$PREFIX/bin/start-server" "$@"
    elif command -v start-server >/dev/null 2>&1; then
        start-server "$@"
    else
        echo -e "${RED}[!] start-server not found. Run 'phone-server setup server' first.${NC}"
        return 1
    fi
}

cmd_server_stop() {
    if [ "$IS_TERMUX" -ne 1 ]; then
        cmd_client_stop "$@"
        return
    fi
    if [ -x "$PREFIX/bin/stop-server" ]; then
        "$PREFIX/bin/stop-server" "$@"
    elif command -v stop-server >/dev/null 2>&1; then
        stop-server "$@"
    else
        killall -9 tor sshd sshd-session 2>/dev/null || true
        echo "[+] Server daemons stopped."
    fi
}

cmd_server_restart() {
    if [ "$IS_TERMUX" -ne 1 ]; then
        cmd_client_restart "$@"
        return
    fi
    if [ -x "$PREFIX/bin/restart-server" ]; then
        "$PREFIX/bin/restart-server" "$@"
    elif command -v restart-server >/dev/null 2>&1; then
        restart-server "$@"
    else
        cmd_server_stop
        sleep 1
        cmd_server_start
    fi
}

cmd_server_status() {
    if [ "$IS_TERMUX" -ne 1 ]; then
        cmd_client_status "$@"
        return
    fi
    if [ -x "$PREFIX/bin/status-server" ]; then
        "$PREFIX/bin/status-server" "$@"
    elif command -v status-server >/dev/null 2>&1; then
        status-server "$@"
    else
        echo -e "${RED}[!] status-server not found. Run 'phone-server setup server' first.${NC}"
        return 1
    fi
}

cmd_server_authorize() {
    if [ "$IS_TERMUX" -ne 1 ]; then
        echo -e "${YELLOW}[!] 'authorize' must be run directly on the Phone Server (Termux).${NC}"
        echo "    To authorize a client from your PC over SSH (if already connected):"
        echo "      ssh phone-server authorize-client <name> '<tor_pub>' '<ssh_pub>'"
        echo "    Or run 'phone-server authorize' directly in Termux on your server phone."
        return 1
    fi
    if [ -x "$PREFIX/bin/authorize-client" ]; then
        "$PREFIX/bin/authorize-client" "$@"
    elif command -v authorize-client >/dev/null 2>&1; then
        authorize-client "$@"
    else
        echo -e "${RED}[!] authorize-client not found. Run 'phone-server setup server' first.${NC}"
        return 1
    fi
}

cmd_setup() {
    TARGET="$1"
    shift || true
    case "$TARGET" in
        server)
            if [ "$IS_TERMUX" -ne 1 ]; then
                echo -e "${RED}[!] Error: 'setup server' must be run inside Android Termux on your phone!${NC}"
                echo "    To set up on your phone, open Termux and run: ./phone-server setup server"
                return 1
            fi
            SCRIPT_PATH=$(find_script "setup-server-termux.sh")
            if [ -n "$SCRIPT_PATH" ]; then
                bash "$SCRIPT_PATH" "$@"
            else
                echo -e "${RED}[!] Could not locate setup-server-termux.sh.${NC}"
                return 1
            fi
            ;;
        client)
            if [ "$IS_TERMUX" -eq 1 ]; then
                cmd_setup client-termux "$@"
            else
                cmd_setup client-linux "$@"
            fi
            ;;
        client-linux|client-pc)
            SCRIPT_PATH=$(find_script "setup-client-linux.sh")
            if [ -n "$SCRIPT_PATH" ]; then
                bash "$SCRIPT_PATH" "$@"
            else
                echo -e "${RED}[!] Could not locate setup-client-linux.sh.${NC}"
                return 1
            fi
            ;;
        client-termux|client-phone|client-mobile)
            if [ "$IS_TERMUX" -ne 1 ]; then
                echo -e "${RED}[!] Error: 'setup client-termux' must be run inside Android Termux on a client phone!${NC}"
                echo "    For Linux PCs, use: phone-server setup client-linux"
                return 1
            fi
            SCRIPT_PATH=$(find_script "setup-client-termux.sh")
            if [ -n "$SCRIPT_PATH" ]; then
                bash "$SCRIPT_PATH" "$@"
            else
                echo -e "${RED}[!] Could not locate setup-client-termux.sh.${NC}"
                return 1
            fi
            ;;
        *)
            echo -e "${RED}[!] Unknown setup target: '$TARGET'${NC}"
            echo "Available targets: server, client, client-linux, client-termux"
            return 1
            ;;
    esac
}

# --- Interactive Menus ---

menu_client() {
    while true; do
        clear 2>/dev/null || true
        show_banner
        echo -e "Active Dashboard: ${GREEN}${BOLD}[CLIENT MODE]${NC}"
        
        # Display configured target if known
        CLIENT_TARGET=$(grep -A 1 "^Host phone-server" "$HOME/.ssh/config" 2>/dev/null | grep HostName | awk '{print $2}' || true)
        if [ -n "$CLIENT_TARGET" ]; then
            echo -e "Target Server   : ${YELLOW}${CLIENT_TARGET}${NC} (via 127.0.0.1:9050)"
        else
            echo -e "Target Server   : ${RED}Not configured yet${NC} (Select option 5 to setup)"
        fi
        echo "------------------------------------------------------------------"
        echo -e "${BOLD}CLIENT OPERATIONS:${NC}"
        echo "  1) Connect / Open Shell          (phone-ssh)"
        echo "  2) Query Server Status           (Check PIDs, clients, battery)"
        echo "  3) Restart Server Remotely       (Clean cycle over Tor)"
        echo "  4) Stop Server Remotely          (Shutdown server over Tor)"
        echo ""
        echo -e "${BOLD}CLIENT CONFIGURATION:${NC}"
        echo "  5) Configure Linux PC Client     (setup-client-linux)"
        echo "  6) Configure Mobile Phone Client (setup-client-termux)"
        echo ""
        echo -e "${BOLD}SWITCH & ADVANCED:${NC}"
        echo "  s) Switch to Server Management Menu"
        echo "  i) Install 'phone-server' to PATH"
        echo "  h) Show Help & CLI Syntax"
        echo "  0) Exit"
        echo "------------------------------------------------------------------"
        read -p "Select an option [1-6, s, i, h, 0]: " CHOICE
        echo ""

        case "$CHOICE" in
            1)
                cmd_client_connect
                read -p "Session closed. Press Enter to return..." _
                ;;
            2)
                cmd_client_status
                echo ""
                read -p "Press Enter to return..." _
                ;;
            3)
                cmd_client_restart
                echo ""
                read -p "Press Enter to return..." _
                ;;
            4)
                cmd_client_stop
                echo ""
                read -p "Press Enter to return..." _
                ;;
            5)
                cmd_setup client-linux
                read -p "Press Enter to return..." _
                ;;
            6)
                cmd_setup client-termux
                read -p "Press Enter to return..." _
                ;;
            s|S)
                menu_server
                return
                ;;
            i|I)
                install_global
                read -p "Press Enter to return..." _
                ;;
            h|H)
                show_help
                read -p "Press Enter to return..." _
                ;;
            0|q|Q|exit)
                echo "Goodbye!"
                exit 0
                ;;
            *)
                echo -e "${RED}[!] Invalid option.${NC}"
                sleep 1
                ;;
        esac
    done
}

menu_server() {
    while true; do
        clear 2>/dev/null || true
        show_banner
        echo -e "Active Dashboard: ${YELLOW}${BOLD}[SERVER MODE]${NC}"
        
        # Display server identity if available
        SERVER_ONION=$(cat "$PREFIX/var/lib/tor/hidden_ssh/hostname" 2>/dev/null || true)
        SERVER_USER=$(whoami 2>/dev/null || true)
        if [ -n "$SERVER_ONION" ]; then
            echo -e "Server Onion    : ${CYAN}${BOLD}${SERVER_ONION}${NC}"
            echo -e "Server User     : ${YELLOW}${BOLD}${SERVER_USER}${NC}"
        fi
        echo "------------------------------------------------------------------"
        echo -e "${BOLD}SERVER OPERATIONS:${NC}"
        echo "  1) Check Local Server Status     (PIDs, sockets, clients, battery)"
        echo "  2) Start Server Daemons          (Launch OpenSSH & Tor quietly)"
        echo "  3) Restart Server Daemons        (Clean cycle)"
        echo "  4) Stop Server Daemons           (Kill all listeners & sessions)"
        echo "  5) Authorize a New Client Device (Register laptop or mobile keys)"
        echo ""
        echo -e "${BOLD}SERVER CONFIGURATION:${NC}"
        echo "  6) Run Server Setup / Reinstall  (setup-server-termux)"
        echo ""
        echo -e "${BOLD}SWITCH & ADVANCED:${NC}"
        echo "  c) Switch to Client Mode Menu"
        echo "  i) Install 'phone-server' to PATH"
        echo "  h) Show Help & CLI Syntax"
        echo "  0) Exit"
        echo "------------------------------------------------------------------"
        read -p "Select an option [1-6, c, i, h, 0]: " CHOICE
        echo ""

        case "$CHOICE" in
            1)
                cmd_server_status
                echo ""
                read -p "Press Enter to return..." _
                ;;
            2)
                cmd_server_start
                echo ""
                read -p "Press Enter to return..." _
                ;;
            3)
                cmd_server_restart
                echo ""
                read -p "Press Enter to return..." _
                ;;
            4)
                cmd_server_stop
                echo ""
                read -p "Press Enter to return..." _
                ;;
            5)
                cmd_server_authorize
                echo ""
                read -p "Press Enter to return..." _
                ;;
            6)
                cmd_setup server
                read -p "Press Enter to return..." _
                ;;
            c|C)
                menu_client
                return
                ;;
            i|I)
                install_global
                read -p "Press Enter to return..." _
                ;;
            h|H)
                show_help
                read -p "Press Enter to return..." _
                ;;
            0|q|Q|exit)
                echo "Goodbye!"
                exit 0
                ;;
            *)
                echo -e "${RED}[!] Invalid option.${NC}"
                sleep 1
                ;;
        esac
    done
}

# --- CLI Routing ---

if [ $# -eq 0 ]; then
    if [ -t 0 ]; then
        # Default to Server Menu on Termux if server is set up, otherwise Client Menu
        if [ "$IS_TERMUX" -eq 1 ] && [ -f "$PREFIX/var/lib/tor/hidden_ssh/hostname" ]; then
            menu_server
        else
            menu_client
        fi
    else
        show_help
    fi
    exit 0
fi

case "$1" in
    # Client Submenu & Commands
    client)
        shift
        if [ $# -eq 0 ]; then
            menu_client
        else
            case "$1" in
                connect|ssh) shift; cmd_client_connect "$@" ;;
                status) shift; cmd_client_status "$@" ;;
                stop) shift; cmd_client_stop "$@" ;;
                restart) shift; cmd_client_restart "$@" ;;
                setup) shift; cmd_setup "$@" ;;
                -h|--help|help) show_help ;;
                *) echo -e "${RED}[!] Unknown client command: $1${NC}"; echo "Run 'phone-server --help' for available commands."; exit 1 ;;
            esac
        fi
        ;;
    # Server Submenu & Commands
    server)
        shift
        if [ $# -eq 0 ]; then
            menu_server
        else
            case "$1" in
                start) shift; cmd_server_start "$@" ;;
                stop) shift; cmd_server_stop "$@" ;;
                restart) shift; cmd_server_restart "$@" ;;
                status) shift; cmd_server_status "$@" ;;
                authorize|auth) shift; cmd_server_authorize "$@" ;;
                setup) shift; cmd_setup server "$@" ;;
                -h|--help|help) show_help ;;
                *) echo -e "${RED}[!] Unknown server command: $1${NC}"; echo "Run 'phone-server --help' for available commands."; exit 1 ;;
            esac
        fi
        ;;
    # Direct Top-level Shortcuts
    connect|ssh|login)
        shift
        cmd_client_connect "$@"
        ;;
    status)
        shift
        if [ "$IS_TERMUX" -eq 1 ] && [ -f "$PREFIX/var/lib/tor/hidden_ssh/hostname" ]; then
            cmd_server_status "$@"
        else
            cmd_client_status "$@"
        fi
        ;;
    start)
        shift
        cmd_server_start "$@"
        ;;
    stop)
        shift
        if [ "$IS_TERMUX" -eq 1 ] && [ -f "$PREFIX/var/lib/tor/hidden_ssh/hostname" ]; then
            cmd_server_stop "$@"
        else
            cmd_client_stop "$@"
        fi
        ;;
    restart)
        shift
        if [ "$IS_TERMUX" -eq 1 ] && [ -f "$PREFIX/var/lib/tor/hidden_ssh/hostname" ]; then
            cmd_server_restart "$@"
        else
            cmd_client_restart "$@"
        fi
        ;;
    authorize|auth)
        shift
        cmd_server_authorize "$@"
        ;;
    setup)
        shift
        cmd_setup "$@"
        ;;
    menu|tui)
        if [ "$IS_TERMUX" -eq 1 ] && [ -f "$PREFIX/var/lib/tor/hidden_ssh/hostname" ]; then
            menu_server
        else
            menu_client
        fi
        ;;
    install)
        install_global
        ;;
    -v|--version|version)
        echo "phone-server version $VERSION"
        ;;
    -h|--help|help)
        show_help
        ;;
    *)
        echo -e "${RED}[!] Unknown command: '$1'${NC}"
        echo "Run 'phone-server --help' for available commands."
        exit 1
        ;;
esac
