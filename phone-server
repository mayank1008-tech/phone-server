#!/bin/bash
# ==============================================================================
# Stealth Tor v3 Phone Server - Master CLI & Interactive Interface
# ==============================================================================
# Unified CLI management tool for headless, zero-discovery Android servers
# over stealth Tor v3 (x25519) and OpenSSH (Ed25519).
# ==============================================================================

set -e

VERSION="1.0.0"

# ANSI Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

# Determine root repository directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Detect runtime environment
IS_TERMUX=0
if [ -n "$PREFIX" ] && [ -d "/data/data/com.termux" ]; then
    IS_TERMUX=1
fi

show_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "=================================================================="
    echo "      🛡️  STEALTH TOR v3 PHONE SERVER CLI (v${VERSION})            "
    echo "=================================================================="
    echo -e "${NC}"
}

show_help() {
    show_banner
    echo -e "${BOLD}USAGE:${NC}"
    echo "  phone-server [COMMAND] [OPTIONS]"
    echo "  phone-server                       (Launches interactive menu)"
    echo ""
    echo -e "${BOLD}SETUP COMMANDS:${NC}"
    echo "  setup server                       Run headless server installer on Android Termux"
    echo "  setup client-linux [onion] [user]  Run client setup on Linux PC (Debian/Ubuntu/Fedora/Arch)"
    echo "  setup client-termux [onion] [user] Run client setup on secondary Android phone"
    echo ""
    echo -e "${BOLD}OPERATIONAL COMMANDS (Client & Server):${NC}"
    echo "  connect [ssh-args]                 Open SSH shell into phone server (alias: ssh)"
    echo "  status [--adb]                     Check daemons, active clients, and battery"
    echo "  start                              Start server daemons (OpenSSH & Tor) on phone"
    echo "  stop [--adb]                       Force stop server daemons and active sessions"
    echo "  restart [--adb]                    Cleanly restart server daemons"
    echo "  authorize [name] [tor_pub] [ssh]   Authorize a new client device on phone server"
    echo ""
    echo -e "${BOLD}GENERAL OPTIONS:${NC}"
    echo "  menu                               Open interactive selection menu"
    echo "  install                            Install phone-server globally to PATH"
    echo "  -v, --version, version             Display CLI version"
    echo "  -h, --help, help                   Display this help message"
    echo ""
    echo -e "${BOLD}EXAMPLES:${NC}"
    echo "  phone-server                       # Launch interactive dropdown/menu"
    echo "  phone-server status                # Check phone server health over Tor"
    echo "  phone-server connect               # Open secure shell into phone"
    echo "  phone-server connect uptime        # Run single command on phone"
    echo "  phone-server setup client-linux    # Configure current Linux machine as client"
    echo "  phone-server authorize laptop      # Register new client keys on server"
    echo "=================================================================="
}

install_global() {
    echo -e "${BLUE}[*] Installing phone-server CLI globally...${NC}"
    if [ "$IS_TERMUX" -eq 1 ]; then
        TARGET="$PREFIX/bin/phone-server"
        cp "$SCRIPT_DIR/phone-server" "$TARGET"
        chmod 755 "$TARGET"
        ln -sf "$TARGET" "$PREFIX/bin/stealth-server"
        echo -e "${GREEN}[+] Installed to $TARGET (and alias stealth-server).${NC}"
    else
        mkdir -p "$HOME/.local/bin"
        TARGET="$HOME/.local/bin/phone-server"
        cp "$SCRIPT_DIR/phone-server" "$TARGET"
        chmod +x "$TARGET"
        ln -sf "$TARGET" "$HOME/.local/bin/stealth-server"
        
        # Ensure ~/.local/bin in PATH
        for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
            if [ -f "$rc" ]; then
                if ! grep -q 'export PATH="$HOME/.local/bin:$PATH"' "$rc" 2>/dev/null; then
                    echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$rc"
                fi
            fi
        done
        echo -e "${GREEN}[+] Installed to $TARGET (and alias stealth-server).${NC}"
        echo -e "${YELLOW}[*] Make sure ~/.local/bin is in your PATH (e.g. source ~/.bashrc).${NC}"
    fi
}

cmd_setup() {
    TARGET="$1"
    shift || true
    case "$TARGET" in
        server)
            if [ "$IS_TERMUX" -ne 1 ]; then
                echo -e "${RED}[!] Error: 'setup server' must be run inside Android Termux on your phone server!${NC}"
                echo "    To set up on your phone, copy this repo to Termux and run: ./phone-server setup server"
                exit 1
            fi
            if [ -f "$SCRIPT_DIR/setup-server-termux.sh" ]; then
                bash "$SCRIPT_DIR/setup-server-termux.sh" "$@"
            else
                echo -e "${RED}[!] Missing setup-server-termux.sh in $SCRIPT_DIR${NC}"
                exit 1
            fi
            ;;
        client-linux|client-pc)
            if [ "$IS_TERMUX" -eq 1 ]; then
                echo -e "${YELLOW}[!] Warning: You are running 'client-linux' inside Termux.${NC}"
                echo "    For a secondary mobile client, run: phone-server setup client-termux"
                read -p "Do you want to continue anyway? [y/N]: " CONFIRM
                if [[ ! "$CONFIRM" =~ ^[yY]$ ]]; then exit 0; fi
            fi
            if [ -f "$SCRIPT_DIR/setup-client-linux.sh" ]; then
                bash "$SCRIPT_DIR/setup-client-linux.sh" "$@"
            else
                echo -e "${RED}[!] Missing setup-client-linux.sh in $SCRIPT_DIR${NC}"
                exit 1
            fi
            ;;
        client-termux|client-phone|client-mobile)
            if [ "$IS_TERMUX" -ne 1 ]; then
                echo -e "${RED}[!] Error: 'setup client-termux' must be run inside Android Termux on a client phone!${NC}"
                echo "    For Linux PCs, use: phone-server setup client-linux"
                exit 1
            fi
            if [ -f "$SCRIPT_DIR/setup-client-termux.sh" ]; then
                bash "$SCRIPT_DIR/setup-client-termux.sh" "$@"
            else
                echo -e "${RED}[!] Missing setup-client-termux.sh in $SCRIPT_DIR${NC}"
                exit 1
            fi
            ;;
        *)
            echo -e "${RED}[!] Unknown setup target: '$TARGET'${NC}"
            echo "Available targets:"
            echo "  • server         : Headless Android Termux server"
            echo "  • client-linux   : Linux PC client (Debian, Ubuntu, Fedora, Arch)"
            echo "  • client-termux  : Secondary Android phone client (Termux)"
            exit 1
            ;;
    esac
}

cmd_connect() {
    if command -v phone-ssh >/dev/null 2>&1; then
        phone-ssh "$@"
    elif [ -x "$PREFIX/bin/phone-ssh" ]; then
        "$PREFIX/bin/phone-ssh" "$@"
    elif [ -x "$HOME/.local/bin/phone-ssh" ]; then
        "$HOME/.local/bin/phone-ssh" "$@"
    else
        ssh phone-server "$@"
    fi
}

cmd_status() {
    if command -v status-server >/dev/null 2>&1; then
        status-server "$@"
    elif [ -x "$PREFIX/bin/status-server" ]; then
        "$PREFIX/bin/status-server" "$@"
    elif [ -x "$HOME/.local/bin/status-server" ]; then
        "$HOME/.local/bin/status-server" "$@"
    else
        ssh -o ConnectTimeout=20 phone-server status-server "$@"
    fi
}

cmd_stop() {
    if command -v stop-server >/dev/null 2>&1; then
        stop-server "$@"
    elif [ -x "$PREFIX/bin/stop-server" ]; then
        "$PREFIX/bin/stop-server" "$@"
    elif [ -x "$HOME/.local/bin/stop-server" ]; then
        "$HOME/.local/bin/stop-server" "$@"
    else
        ssh -o ConnectTimeout=20 phone-server stop-server "$@"
    fi
}

cmd_restart() {
    if command -v restart-server >/dev/null 2>&1; then
        restart-server "$@"
    elif [ -x "$PREFIX/bin/restart-server" ]; then
        "$PREFIX/bin/restart-server" "$@"
    elif [ -x "$HOME/.local/bin/restart-server" ]; then
        "$HOME/.local/bin/restart-server" "$@"
    else
        ssh -o ConnectTimeout=20 phone-server restart-server "$@"
    fi
}

cmd_start() {
    if [ -x "$PREFIX/bin/start-server" ]; then
        "$PREFIX/bin/start-server" "$@"
    elif command -v start-server >/dev/null 2>&1; then
        start-server "$@"
    else
        echo -e "${RED}[!] 'start' can only be executed directly on the Phone Server (Termux).${NC}"
        echo "    If you are on a client machine, connect first or use physical access."
        exit 1
    fi
}

cmd_authorize() {
    if [ -x "$PREFIX/bin/authorize-client" ]; then
        "$PREFIX/bin/authorize-client" "$@"
    elif command -v authorize-client >/dev/null 2>&1; then
        authorize-client "$@"
    else
        echo -e "${RED}[!] 'authorize' must be run directly on the Phone Server (Termux).${NC}"
        exit 1
    fi
}

interactive_menu() {
    while true; do
        clear 2>/dev/null || true
        show_banner
        if [ "$IS_TERMUX" -eq 1 ]; then
            echo -e "Platform: ${GREEN}Android Termux${NC} (Server / Mobile Client mode)"
        else
            echo -e "Platform: ${YELLOW}Linux Workstation${NC} (Client PC mode)"
        fi
        echo "------------------------------------------------------------------"
        echo -e "${BOLD}SETUP & INSTALLATION:${NC}"
        echo "  1) 📱 Setup Server                 (Run on Android Phone to become Server)"
        echo "  2) 💻 Setup Client - Linux PC      (Run on Linux PC to connect to Phone)"
        echo "  3) 📲 Setup Client - Mobile Phone  (Run on 2nd Phone to connect to Phone)"
        echo ""
        echo -e "${BOLD}SERVER MANAGEMENT & OPERATIONS:${NC}"
        echo "  4) ⚡ Connect to Phone Server      (Open secure SSH shell)"
        echo "  5) 📊 Check Server Status          (Query active PIDs, sockets, clients)"
        echo "  6) 🔄 Restart Server Services      (Clean daemon cycle)"
        echo "  7) 🛑 Stop Server Services         (Kill all listeners & worker sessions)"
        echo "  8) 🔑 Authorize a New Client       (Register keys on server phone)"
        echo ""
        echo -e "${BOLD}MAINTENANCE & UTILITIES:${NC}"
        echo "  9) ⚙️  Install 'phone-server' to PATH (Use command from anywhere)"
        echo "  h) ❓ Show CLI Help & Syntax"
        echo "  0) 🚪 Exit"
        echo "------------------------------------------------------------------"
        read -p "Select an option [0-9, h]: " CHOICE
        echo ""

        case "$CHOICE" in
            1)
                cmd_setup server
                read -p "Press Enter to return to menu..." _
                ;;
            2)
                cmd_setup client-linux
                read -p "Press Enter to return to menu..." _
                ;;
            3)
                cmd_setup client-termux
                read -p "Press Enter to return to menu..." _
                ;;
            4)
                cmd_connect
                read -p "Session ended. Press Enter to return to menu..." _
                ;;
            5)
                cmd_status
                echo ""
                read -p "Press Enter to return to menu..." _
                ;;
            6)
                cmd_restart
                echo ""
                read -p "Press Enter to return to menu..." _
                ;;
            7)
                cmd_stop
                echo ""
                read -p "Press Enter to return to menu..." _
                ;;
            8)
                cmd_authorize
                echo ""
                read -p "Press Enter to return to menu..." _
                ;;
            9)
                install_global
                echo ""
                read -p "Press Enter to return to menu..." _
                ;;
            h|H|help)
                show_help
                read -p "Press Enter to return to menu..." _
                ;;
            0|q|Q|exit)
                echo "Goodbye!"
                exit 0
                ;;
            *)
                echo -e "${RED}[!] Invalid option: '$CHOICE'${NC}"
                sleep 1
                ;;
        esac
    done
}

# --- CLI Routing ---
if [ $# -eq 0 ]; then
    if [ -t 0 ]; then
        interactive_menu
    else
        show_help
    fi
    exit 0
fi

case "$1" in
    setup)
        shift
        cmd_setup "$@"
        ;;
    connect|ssh|login)
        shift
        cmd_connect "$@"
        ;;
    status)
        shift
        cmd_status "$@"
        ;;
    stop)
        shift
        cmd_stop "$@"
        ;;
    start)
        shift
        cmd_start "$@"
        ;;
    restart)
        shift
        cmd_restart "$@"
        ;;
    authorize|auth)
        shift
        cmd_authorize "$@"
        ;;
    menu|tui)
        interactive_menu
        ;;
    install)
        install_global
        ;;
    -v|--version|version)
        echo "phone-server version $VERSION"
        ;;
    -h|--help|help)
        show_help
        ;;
    *)
        echo -e "${RED}[!] Unknown command: '$1'${NC}"
        echo "Run 'phone-server --help' for available commands."
        exit 1
        ;;
esac
